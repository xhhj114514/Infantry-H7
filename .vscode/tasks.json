{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cmake",
            "command": "build",
            // "dependsOn":"Clean CMake File",
        },
        {
            "label":"Clean Build File",
            "type":"shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug",
                "--target",
                "clean"
            ],
            "group": "build",
            "presentation":{
                "reveal":"always",
                "panel":"new"
            },
            "problemMatcher":[]
        },
        // {
        //     "label": "Configure & Restart clangd",
        //     "type": "shell",
        //     "command": "cmd.exe",                 // 关键第1行：强制用 cmd.exe
        //     "args": [
        //         "/C",                             // 关键第2行：cmd 的参数
        //         "code --command cmake.configure && code --command clangd.restartLanguageServer"
        //     ],
        // },
        {
            "label": "Configure All Projects",//Must Be Done after "Remove CMake Cache"
            "type": "cmake",
            "command": "configure",
            // "dependsOrder": "sequence",          // 新增第1行：按顺序执行依赖任务
            // "dependsOn": "Configure & Restart clangd",  // 新增第2行：配置完成后运行这个任务
        },
        {
            "label":"Remove CMake Cache",
            "type":"shell",
            "command": "Remove-Item -Recurse -Force ${workspaceFolder}/build",
        },
		{
			"label": "Flash with OpenOCD",
			"type": "shell",
			"command": "openocd",
			"args": [
				"-f",
                "${workspaceFolder}/openocd.cfg",
                "-c",
                "program ./build/Debug/${workspaceFolderBasename}.elf verify reset exit"
			],
            "dependsOn": "build",
			"problemMatcher": [],
		},
        {
            "label": "Flash AND Start Debug",
            "type": "shell",
            "command": "Ozone",
            "args": [
                "${workspaceFolder}\\DBG\\DBG.jdebug",
                // "-script",
                // "${workspaceFolder}\\Load_Plugin.js"
            ],
            // "dependsOn": "Flash with OpenOCD",
            // "group": {
            //     "kind": "build",
            //     "isDefault": false
            // },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}